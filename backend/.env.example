# AirBooking Backend Environment Configuration
SECRET_KEY=django-insecure-airbooking-production-grade-key-2026-secret-xyz987
DEBUG=True
ALLOWED_HOSTS=*

# Database Engine: 'sqlite' or 'mysql'
DB_ENGINE=sqlite
# For MySQL:
# DB_NAME=airbooking_db
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=localhost
# DB_PORT=3306

# Celery and Redis Settings
# In local development without Redis running, set to True to execute tasks synchronously
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email Backend (Console for local development; SMTP for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AirBooking System <noreply@airbooking.com>

# External Real-time Flight APIs
OPENSKY_API_URL=https://opensky-network.org/api
AIRLABS_API_KEY=
